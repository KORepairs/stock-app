# Copy to .env and edit:
BASIC_USER=me
BASIC_PASS=secret

NODE_ENV=development
ALLOW_DEV_DB_BOOTSTRAP=
# Manual one-shot only. Never used at application startup.
# Development:
# ALLOW_DUPLICATE_REVIEW_MIGRATION=YES_CREATE_DUPLICATE_REVIEW_DECISIONS_IN_DEVELOPMENT
# Production:
# ALLOW_DUPLICATE_REVIEW_MIGRATION=YES_CREATE_DUPLICATE_REVIEW_DECISIONS_IN_PRODUCTION
ALLOW_DUPLICATE_REVIEW_MIGRATION=
DATABASE_URL=
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=

# The app will bind to this port automatically in dev.
# On Railway, the platform sets PORT for you.
PORT=4000

# Optional: where to store the SQLite file (esp. on Railway volume like /data)
# DB_DIR=/data
# Or explicitly point to a file path:
# DB_FILE=/data/data.db
